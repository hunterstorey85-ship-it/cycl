<section class="cart-page section">
  <div class="container">
    <h1>Shopping Bag</h1>

    {%- if cart.item_count > 0 -%}

      <form action="/cart" method="post" class="cart-page-form">
        <div class="cart-page__grid">

          <!-- Cart Items -->
          <div>
            <div class="cart-table">
              <div class="cart-table__head" aria-hidden="true">
                <span></span>
                <span>Product</span>
                <span class="hide-mobile">Quantity</span>
                <span>Total</span>
              </div>

              {%- for item in cart.items -%}
                <div class="cart-item" data-cart-item data-key="{{ item.key }}">
                  <a href="{{ item.url }}" class="cart-item__image">
                    {%- if item.image -%}
                      {{
                        item.image
                        | image_url: width: 200
                        | image_tag:
                          loading: 'lazy',
                          alt: item.image.alt | default: item.title | escape,
                          width: 100,
                          height: 133
                      }}
                    {%- endif -%}
                  </a>

                  <div class="cart-item__info">
                    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <div class="cart-item__variant">{{ item.variant.title }}</div>
                    {%- endunless -%}
                    <div class="cart-item__price">{{ item.final_price | money }}</div>

                    <div class="cart-item__quantity">
                      <button
                        type="button"
                        class="cart-item__qty-btn cart-page-qty-btn"
                        data-action="decrease"
                        data-key="{{ item.key }}"
                        aria-label="Decrease quantity"
                      >−</button>
                      <span class="cart-item__qty-value cart-page-qty-value">{{ item.quantity }}</span>
                      <button
                        type="button"
                        class="cart-item__qty-btn cart-page-qty-btn"
                        data-action="increase"
                        data-key="{{ item.key }}"
                        aria-label="Increase quantity"
                      >+</button>
                    </div>

                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-item__remove">Remove</a>
                  </div>

                  <div class="cart-item__price hide-mobile">
                    {{ item.final_line_price | money }}
                  </div>
                </div>
              {%- endfor -%}

            </div>
          </div>

          <!-- Order Summary -->
          <div class="cart-summary">
            <h2 style="font-size: 0.875rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 1.5rem;">Order Summary</h2>

            <div class="cart-summary__row">
              <span>Subtotal ({{ cart.item_count }} items)</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <div class="cart-summary__row">
              <span>Shipping</span>
              <span style="color:#888;">Calculated at checkout</span>
            </div>

            {%- if cart.total_discounts > 0 -%}
              <div class="cart-summary__row" style="color: #555;">
                <span>Discounts</span>
                <span>−{{ cart.total_discounts | money }}</span>
              </div>
            {%- endif -%}

            <div class="cart-summary__row cart-summary__row--total">
              <span>Total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <!-- Discount code -->
            <div style="margin-top: 1.5rem;">
              <input
                type="text"
                name="discount"
                placeholder="Discount code"
                style="width:100%; padding:0.75rem; border:1px solid #EBEBEB; background:transparent; font-size:0.875rem; outline:none; margin-bottom:0.5rem;"
              >
            </div>

            <a href="/checkout" class="btn btn--primary cart-summary__btn">
              Proceed to Checkout
            </a>

            <a href="/collections/all" style="display:block; text-align:center; font-size:0.8125rem; color:#888; margin-top:1rem; text-decoration:underline; text-underline-offset:2px;">
              Continue Shopping
            </a>
          </div>

        </div>
      </form>

    {%- else -%}

      <div style="text-align:center; padding:5rem 0;">
        <p style="color:#888; margin-bottom:2rem;">Your cart is empty.</p>
        <a href="/collections/all" class="btn btn--primary">Shop Now</a>
      </div>

    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}

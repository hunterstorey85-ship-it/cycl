{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: product.id
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
-%}

<section class="product-page">
  <div class="container">
    <div class="product-page__grid">

      <!-- Gallery -->
      <div class="product-gallery">
        <div class="product-gallery__main">
          {%- if product.featured_image -%}
            {{
              current_variant.featured_image | default: product.featured_image
              | image_url: width: 1200
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                id: 'ProductMainImage',
                sizes: '(min-width: 768px) 55vw, 100vw',
                widths: '500, 700, 900, 1100, 1200',
                alt: product.featured_image.alt | default: product.title | escape
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbs">
            {%- for image in product.images limit: 5 -%}
              <button
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-src="{{ image | image_url: width: 1200 }}"
                data-alt="{{ image.alt | escape }}"
                type="button"
                aria-label="View image {{ forloop.index }}"
              >
                {{
                  image
                  | image_url: width: 200
                  | image_tag:
                    loading: 'lazy',
                    alt: image.alt | escape
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Info -->
      <div class="product-info">

        <p class="product-info__drop-label">— Trending Now</p>

        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__price">
          {%- if on_sale -%}
            <span class="product-info__price--compare">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
          <span id="ProductPrice">{{ current_variant.price | money }}</span>
        </div>

        <hr class="product-info__divider">

        {%- form 'product', product, id: product_form_id, class: 'product-form' -%}

          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="variant-selector" data-option-index="{{ forloop.index0 }}">
                <div class="variant-selector__label">
                  {{ option.name }}
                  <span id="SelectedOption{{ forloop.index }}">{{ option.selected_value }}</span>
                </div>
                <div class="variant-selector__options" role="group" aria-label="{{ option.name }}">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign variant_available = false
                      for variant in product.variants
                        if variant.option1 == value or variant.option2 == value or variant.option3 == value
                          if variant.available
                            assign variant_available = true
                          endif
                        endif
                      endfor
                    -%}
                    <button
                      type="button"
                      class="variant-option{% if option.selected_value == value %} is-selected{% endif %}{% unless variant_available %} is-unavailable{% endunless %}"
                      data-option-position="{{ forloop.parentloop.index }}"
                      data-option-value="{{ value | escape }}"
                      aria-pressed="{{ option.selected_value == value }}"
                      {% unless variant_available %}aria-disabled="true"{% endunless %}
                    >
                      {{- value -}}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <button
            type="submit"
            name="add"
            class="btn btn--primary product-form__add"
            data-default-text="Add to Cart"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              Add to Cart
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>

        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="product-description">
            {{ product.description }}
          </div>
        {%- endif -%}

        <div class="accordion" style="margin-top: 2rem;">

          {%- if section.settings.show_shipping -%}
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span>Shipping & Returns</span>
                <span class="accordion__icon">+</span>
              </button>
              <div class="accordion__content" role="region">
                <div class="accordion__inner">
                  {{ section.settings.shipping_text | default: 'Free shipping on all orders. Ships within 3–5 business days. Returns accepted within 30 days of delivery.' }}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.show_sizing -%}
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span>Size Guide</span>
                <span class="accordion__icon">+</span>
              </button>
              <div class="accordion__content" role="region">
                <div class="accordion__inner">
                  {{ section.settings.sizing_text | default: "Unisex sizing. Size up for an oversized look. Model is 6'0\" and wears a size M." }}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.show_care -%}
            <div class="accordion__item">
              <button class="accordion__trigger" type="button" aria-expanded="false">
                <span>Care Instructions</span>
                <span class="accordion__icon">+</span>
              </button>
              <div class="accordion__content" role="region">
                <div class="accordion__inner">
                  {{ section.settings.care_text | default: 'Machine wash cold on a gentle cycle. Lay flat to dry. Do not tumble dry or iron over the print.' }}
                </div>
              </div>
            </div>
          {%- endif -%}

        </div>

      </div>
    </div>
  </div>
</section>

<script>
  document.querySelector('.product-form').dataset.variants = {{ product.variants | json }};
</script>

{% schema %}
{
  "name": "Product Information",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "Accordion Sections"
    },
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show shipping & returns",
      "default": true
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping & returns text"
    },
    {
      "type": "checkbox",
      "id": "show_sizing",
      "label": "Show size guide",
      "default": true
    },
    {
      "type": "textarea",
      "id": "sizing_text",
      "label": "Size guide text"
    },
    {
      "type": "checkbox",
      "id": "show_care",
      "label": "Show care instructions",
      "default": true
    },
    {
      "type": "textarea",
      "id": "care_text",
      "label": "Care instructions text"
    }
  ]
}
{% endschema %}

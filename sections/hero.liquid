<section
  class="hero hero--{{ section.settings.height }}{% unless section.settings.image %} hero--no-image{% endunless %}"
  style="
    {%- unless section.settings.image -%}
      background-color: {{ section.settings.background_color | default: '#0f0f0f' }};
    {%- endunless -%}
  "
>

  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero__image',
          sizes: '100vw',
          widths: '375, 550, 768, 1024, 1440, 1920, 2000',
          alt: section.settings.heading | escape
      }}
    </div>
    {%- if section.settings.overlay_opacity > 0 -%}
      <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    {%- endif -%}
  {%- endif -%}

  <div class="container">
    <div
      class="hero__content"
      style="
        text-align: {{ section.settings.text_alignment }};
        {%- if section.settings.text_alignment == 'center' -%}
          align-items: center;
        {%- elsif section.settings.text_alignment == 'right' -%}
          align-items: flex-end;
        {%- else -%}
          align-items: flex-start;
        {%- endif -%}
        {%- if section.settings.content_position contains 'top' -%}
          justify-content: flex-start;
        {%- elsif section.settings.content_position contains 'middle' -%}
          justify-content: center;
        {%- else -%}
          justify-content: flex-end;
        {%- endif -%}
      "
    >

      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow"
          style="color: {{ section.settings.text_color }}; opacity: 0.8;"
        >
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1
          class="hero__heading"
          style="color: {{ section.settings.text_color }};"
        >
          {{ section.settings.heading | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p
          class="hero__subheading"
          style="color: {{ section.settings.text_color }};"
        >
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="btn {{ section.settings.button_style }}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}

      {%- if section.settings.show_logo_mark -%}
        <div class="hero__logomark" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 310 80" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <!-- C -->
            <path d="M 58,14 A 32,32 0 1 0 58,66" stroke-width="3"/>
            <!-- Y -->
            <path d="M 84,10 L 114,42 L 144,10 M 114,42 L 114,70" stroke-width="3"/>
            <!-- C -->
            <path d="M 228,14 A 32,32 0 1 0 228,66" stroke-width="3"/>
            <!-- L -->
            <path d="M 252,10 L 252,70 L 305,70" stroke-width="3"/>
          </svg>
        </div>
      {%- endif -%}

    </div>
  </div>

</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 25
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color (no image)",
      "default": "#F5F5F5"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New Season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for\nEveryday Life"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Minimal essentials crafted from premium materials. Made to last."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "btn--white", "label": "White (for dark background)" },
        { "value": "btn--primary", "label": "Black" },
        { "value": "btn--secondary", "label": "Outlined" }
      ],
      "default": "btn--white"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_logo_mark",
      "label": "Show CYCL logo mark",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        { "value": "full-height", "label": "Full height (85vh)" },
        { "value": "medium-height", "label": "Medium (65vh)" }
      ],
      "default": "full-height"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}

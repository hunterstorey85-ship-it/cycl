<aside class="cart-drawer" role="dialog" aria-modal="true" aria-label="Shopping cart">
  <div class="cart-drawer__header">
    <span class="cart-drawer__title">Your Cart</span>
    <button class="cart-drawer__close" data-close-cart aria-label="Close cart" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="cart-drawer__body">
    <div class="cart-drawer__items">
      <!-- Populated via JS -->
      <div class="cart-drawer__empty">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#CCC" stroke-width="1">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <p>Your cart is empty</p>
        <a href="/collections/all" class="btn btn--secondary" style="margin-top:1rem; font-size:0.75rem; padding: 0.75rem 1.75rem;">Shop Now</a>
      </div>
    </div>
  </div>

  <div class="cart-drawer__footer">
    <div class="cart-drawer__subtotal">
      <span class="cart-drawer__subtotal-label">Subtotal</span>
      <span class="cart-drawer__subtotal-price">—</span>
    </div>
    <p class="cart-drawer__note">Shipping & taxes calculated at checkout</p>
    <a href="/checkout" class="btn btn--primary cart-drawer__checkout">
      Checkout
    </a>
  </div>
</aside>

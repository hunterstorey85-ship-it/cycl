<footer class="site-footer" role="contentinfo"><div class="container">
  <div class="site-footer__grid">
    <div class="footer-brand">
      {%- assign _logo = settings.logo | default: section.settings.logo -%}
      <a href="{{ routes.root_url }}" class="footer-brand__logo">{%- if _logo != blank -%}{{ _logo | image_url: width: 160 | image_tag: alt: shop.name, loading: 'lazy', style: 'max-height:60px;width:auto;' }}{%- else -%}{{ shop.name }}{%- endif -%}</a>
      {%- if section.settings.tagline != blank -%}<p class="footer-brand__tagline">{{ section.settings.tagline | escape }}</p>{%- endif -%}
      <div class="footer-social">
        {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" class="footer-social__link" aria-label="Instagram" target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}
        {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" class="footer-social__link" aria-label="TikTok" target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9a8.16 8.16 0 004.77 1.52V7.07a4.85 4.85 0 01-1-.38z"/></svg></a>{%- endif -%}
      </div>
    </div>
    {%- for block in section.blocks -%}{%- if block.type == 'link_list' -%}<div class="footer-col" {{ block.shopify_attributes }}><h4 class="footer-col__heading">{{ block.settings.heading }}</h4>{%- if block.settings.menu != blank -%}<ul class="footer-col__list">{%- for link in linklists[block.settings.menu].links -%}<li><a href="{{ link.url }}" class="footer-col__link">{{ link.title }}</a></li>{%- endfor -%}</ul>{%- endif -%}</div>{%- endif -%}{%- endfor -%}
    <div class="footer-col">
      <h4 class="footer-col__heading">{{ section.settings.newsletter_heading | default: 'Stay in the loop' }}</h4>
      <p class="footer-newsletter__text">{{ section.settings.newsletter_text | default: 'Be first to know when new drops hit.' }}</p>
      {%- form 'customer', id: 'footer-newsletter' -%}<input type="hidden" name="contact[tags]" value="newsletter"><div class="footer-newsletter__form newsletter-form"><input type="email" name="contact[email]" class="footer-newsletter__input" placeholder="{{ section.settings.email_placeholder | default: 'your@email.com' }}" autocomplete="email" required><button type="submit" class="footer-newsletter__btn">{{ section.settings.subscribe_label | default: 'Subscribe' }}</button></div>{%- if form.posted_successfully? -%}<p style="color:rgba(255,255,255,0.6);font-size:0.8125rem;margin-top:0.75rem;">Thank you.</p>{%- endif -%}{%- endform -%}
    </div>
  </div>
  <div class="site-footer__bottom"><p class="site-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.</p><nav class="site-footer__legal">{%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}{%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{%- endif -%}{%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}{%- if shop.shipping_policy -%}<a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{%- endif -%}<a href="{{ routes.search_url }}">Search</a></nav></div>
</div></footer>
{% schema %}{"name":"Footer","settings":[{"type":"image_picker","id":"logo","label":"Footer logo"},{"type":"text","id":"tagline","label":"Brand tagline","default":"Clothing inspired by the culture everyone's watching."},{"type":"url","id":"instagram","label":"Instagram URL"},{"type":"url","id":"tiktok","label":"TikTok URL"},{"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"Stay in the loop"},{"type":"text","id":"newsletter_text","label":"Newsletter description","default":"Be first to know when new drops hit."},{"type":"text","id":"email_placeholder","label":"Email placeholder","default":"your@email.com"},{"type":"text","id":"subscribe_label","label":"Subscribe button label","default":"Subscribe"}],"blocks":[{"type":"link_list","name":"Menu column","settings":[{"type":"text","id":"heading","label":"Column heading","default":"Shop"},{"type":"link_list","id":"menu","label":"Menu"}]}],"max_blocks":3}{% endschema %}

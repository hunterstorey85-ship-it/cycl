{%- comment -%}
  Renders a product card.
  Accepts:
    - product: {Object} Product object (required)
    - show_vendor: {Boolean} Show vendor name
    - show_quick_add: {Boolean} Show quick add button
{%- endcomment -%}

{%- liquid
  assign show_vendor = show_vendor | default: false
  assign show_quick_add = show_quick_add | default: true
  assign first_variant = product.first_available_variant | default: product.variants.first
  assign secondary_image = product.images[1]
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<article class="product-card" aria-label="{{ product.title | escape }}">
  <a href="{{ product.url }}" class="product-card__link" tabindex="-1" aria-hidden="true">
    <div class="product-card__media">

      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            class: 'product-card__image product-card__image--primary',
            sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw',
            widths: '300, 400, 500, 600, 800',
            alt: product.featured_image.alt | default: product.title | escape
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__image--primary placeholder-svg' }}
      {%- endif -%}

      {%- if secondary_image -%}
        {{
          secondary_image
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            class: 'product-card__image product-card__image--secondary',
            sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw',
            widths: '300, 400, 500, 600, 800',
            alt: secondary_image.alt | default: product.title | escape
        }}
      {%- endif -%}

      {%- if on_sale -%}
        <span class="product-card__badge product-card__badge--sale">Sale</span>
      {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
        <span class="product-card__badge">New</span>
      {%- endif -%}

      {%- if show_quick_add and first_variant and first_variant.available -%}
        <button
          class="product-card__quick-add"
          data-variant-id="{{ first_variant.id }}"
          data-default-text="Quick Add"
          type="button"
          aria-label="Quick add {{ product.title | escape }} to cart"
        >
          Quick Add
        </button>
      {%- elsif show_quick_add and product.available == false -%}
        <span class="product-card__quick-add" style="pointer-events:none; opacity:0.6;">Sold Out</span>
      {%- endif -%}

    </div>
  </a>

  <div class="product-card__info">
    {%- if show_vendor -%}
      <div class="product-card__vendor">{{ product.vendor }}</div>
    {%- endif -%}

    <a href="{{ product.url }}" class="product-card__title-link">
      <h3 class="product-card__title">{{ product.title | escape }}</h3>
    </a>

    <div class="product-card__price">
      {%- if on_sale -%}
        <span class="product-card__price--sale">{{ product.price | money }}</span>
        <span class="product-card__price--compare">{{ product.compare_at_price | money }}</span>
      {%- else -%}
        <span>
          {%- if product.price_varies -%}
            From {{ product.price_min | money }}
          {%- else -%}
            {{ product.price | money }}
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>
  </div>
</article>
